# Copia a .env.local (local) o pega las mismas keys en Vercel → Settings → Environment Variables

# --- IA (failover silencioso: Gemini → Grok → Groq) ---
# Gratis: https://aistudio.google.com/apikey
# En producción (Vercel) TODOS los usuarios comparten esta cuota.
GEMINI_API_KEY=tu-clave-aqui
GEMINI_MODEL=gemini-2.5-flash
# Opcional: más keys de Gemini (si una falla por cuota, prueba la siguiente)
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# o lista: GEMINI_API_KEYS=key1,key2

# Plan B — Grok (xAI), gratis en https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Plan C — Groq (gratis), https://console.groq.com/keys
# Ojo: Groq ≠ Grok. Las keys de Groq suelen empezar con gsk_
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# YouTube Data API v3 — Google Cloud Console (API key, cuota free)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- Cuenta + sync (Supabase) — REQUERIDO para exigir login ---
# Sin estas vars: cualquiera entra sin cuenta.
# Con estas vars: RequireAuth → /login obligatorio.
# Guía: DEPLOY.md
#
# 1) SQL Editor → web/supabase/schema.sql
# 2) Auth → Google ON (recomendado) + Email opcional
# 3) URL Configuration:
#    Local:  http://localhost:3000  +  /auth/callback
#    Prod:   https://TU-APP.vercel.app  +  /auth/callback
# 4) Settings → API → URL y anon key:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
